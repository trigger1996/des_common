digraph ClosedLoop {
rankdir=LR;
node [shape=ellipse];
start [shape=point];
start -> L0;
L0 [label="0\nC0"];
L1 [label="1\nC0"];
L2 [label="2\nC0"];
L3 [label="3\nC1"];
L4 [label="4\nC1"];
L0 -> L1 [label="a1 [uo] [uc]"];
L0 -> L2 [label="a2 [uo] [uc]"];
L1 -> L3 [label="o [uc]"];
L2 -> L4 [label="o [uc]"];
L3 -> L3 [label="o [uc]"];
L4 -> L4 [label="o [uc]"];
}