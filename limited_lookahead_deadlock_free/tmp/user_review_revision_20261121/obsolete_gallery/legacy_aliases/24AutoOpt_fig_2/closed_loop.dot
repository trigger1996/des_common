L4 [label="q4\nC4"];
L0 -> L1 [label="a"];
L0 -> L2 [label="e [uc]"];
L1 -> L3 [label="a"];
L1 -> L0 [label="d [uc]"];
L1 -> L2 [label="e [uc]"];
L2 -> L0 [label="a"];
L2 -> L1 [label="e [uc]"];
L3 -> L4 [label="d [uc]"];
L3 -> L3 [label="e [uc]"];
L4 -> L4 [label="d [uc]"];
}