digraph ClosedLoop {
rankdir=LR;
node [shape=ellipse];
start [shape=point];
start -> L0;
L0 [label="0\nC0"];
L1 [label="1\nC0"];
L2 [label="2\nC0"];
L3 [label="3\nC1"];
L4 [label="4\nC1"];
L5 [label="5\nC2"];
L0 -> L1 [label="u1 [uo]"];
L0 -> L2 [label="u2 [uo]"];
L1 -> L3 [label="a"];
L2 -> L4 [label="a"];
L3 -> L5 [label="a"];
L4 -> L5 [label="b"];
L5 -> L5 [label="a"];
}