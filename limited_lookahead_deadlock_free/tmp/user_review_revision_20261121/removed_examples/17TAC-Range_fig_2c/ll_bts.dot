digraph LLBTS {
rankdir=LR;
node [fontname="Arial"];
D0 [shape=box,label="{1}",color=red];
D1 [shape=box,label="{3}",color=red];
D2 [shape=box,label="{4}",color=red];
O0 [shape=ellipse,label="{1}\nC={}",color=red];
O1 [shape=ellipse,label="{1}\nC={c1}",color=red];
O2 [shape=ellipse,label="{1}\nC={c1,c2}",color=red];
O3 [shape=ellipse,label="{1}\nC={c2}",color=red];
D0 -> O0 [label="{}"];
D0 -> O1 [label="c1"];
D0 -> O2 [label="c1,c2"];
D0 -> O3 [label="c2"];
O0 -> D1 [label="a"];
O0 -> D2 [label="b"];
O1 -> D1 [label="a"];
O1 -> D2 [label="b"];
O2 -> D1 [label="a"];
O2 -> D2 [label="b"];
O3 -> D1 [label="a"];
O3 -> D2 [label="b"];
}