digraph BTS {
rankdir=LR;
node [fontname="Arial"];
D0 [shape=box,label="{0}",color=red];
O0 [shape=ellipse,label="{0}\nC={}",color=red];
O1 [shape=ellipse,label="{0}\nC={b}",color=red];
