O3 [shape=ellipse,label="{0}\nC={c}",color=red];
O4 [shape=ellipse,label="{0,1}\nC={a}",color=red];
O5 [shape=ellipse,label="{0,1}\nC={a,b}",color=red];
O6 [shape=ellipse,label="{0,1}\nC={a,b,c}",color=red];
O7 [shape=ellipse,label="{0,1}\nC={a,c}",color=red];
D0 -> O0 [label="{}"];
